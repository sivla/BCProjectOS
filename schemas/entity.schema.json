{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bcprojectos.invalid/schemas/entity.schema.json",
  "title": "BCProjectOS Canonical Entity",
  "type": "object",
  "required": ["schema_version","id","customer_id","entity_type","title","lifecycle_status","created_at","relations"],
  "properties": {
    "schema_version": {"const":1},
    "id": {"type":"string","pattern":"^(CUS|PRJ|SUP|MTG|FILE|KNO|PROC|BR|TKT|REQ|CHG|EVD)-[0-9A-HJKMNP-TV-Z]{26}$"},
    "customer_id": {"type":"string","pattern":"^CUS-[0-9A-HJKMNP-TV-Z]{26}$"},
    "entity_type": {"enum":["customer","project","support_case","meeting","external_file","knowledge_item","business_process","business_rule","ticket","requirement","openspec_change","evidence"]},
    "title": {"type":"string","minLength":1},
    "lifecycle_status": {"enum":["draft","active","inactive","archived","deleted"]},
    "created_at": {"type":"string","format":"date-time"},
    "relations": {"type":"array","items":{"$ref":"#/$defs/relation"}},
    "document_type": {"type":"string"},
    "tags": {"type":"object"},
    "approval_status": {"type":"string"},
    "evidence_refs": {"type":"array","items":{"type":"string"}},
    "evidence_type": {"type":"string"},
    "external_refs": {"type":"array","items":{"type":"object","required":["system","key"],"properties":{"system":{"type":"string"},"key":{"type":"string"}},"additionalProperties":false}},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "size_bytes": {"type":"integer","minimum":0},
    "media_type": {"type":"string"},
    "original_name": {"type":"string"},
    "blob_path": {"type":"string"}
  },
  "$defs": {
    "relation": {
      "type":"object",
      "required":["type","target_id"],
      "properties":{"type":{"type":"string"},"target_id":{"type":"string"}},
      "additionalProperties":false
    }
  },
  "additionalProperties": false
}
