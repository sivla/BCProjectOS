{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.invalid/schemas/customer-workspace-foundation.schema.json",
  "title": "Spectra Customer Workspace Foundation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "contract_version", "record_type", "classification", "profile", "customer", "environments", "companies", "projects", "support_cases", "people", "role_assignments", "knowledge_items", "budgets", "commitments", "relations"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "product_id": {"type": "string", "enum": ["spectra"]},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "record_type": {"type": "string", "enum": ["customer-workspace-foundation"]},
    "classification": {"type": "string", "enum": ["synthetic-fixture", "customer-workspace"]},
    "profile": {"type": "string", "enum": ["implementation", "support-only"]},
    "customer": {"$ref": "#/$defs/customer"},
    "environments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/environment"}},
    "companies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/company"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "support_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/supportCase"}},
    "people": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/person"}},
    "role_assignments": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/roleAssignment"}},
    "knowledge_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knowledge"}},
    "budgets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/budget"}},
    "commitments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commitment"}},
    "relations": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "customer": {"type": "object", "additionalProperties": false, "required": ["id", "name", "status"], "properties": {"id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "name": {"type": "string", "minLength": 3}, "status": {"type": "string", "enum": ["active", "inactive"]}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "name", "kind", "status"], "properties": {"id": {"type": "string", "pattern": "^ENV-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "name": {"type": "string", "minLength": 3}, "kind": {"type": "string", "enum": ["sandbox", "non-production", "production-reference"]}, "status": {"type": "string", "enum": ["planned", "active", "inactive"]}}},
    "company": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "environment_id", "name", "status"], "properties": {"id": {"type": "string", "pattern": "^CMP-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "environment_id": {"type": "string", "pattern": "^ENV-[A-Z0-9-]{3,48}$"}, "name": {"type": "string", "minLength": 3}, "status": {"type": "string", "enum": ["planned", "active", "inactive"]}}},
    "project": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "project_type", "status", "company_ids"], "properties": {"id": {"type": "string", "pattern": "^PRJ-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "project_type": {"type": "string", "enum": ["implementation", "fit-gap", "migration"]}, "status": {"type": "string", "enum": ["planned", "active", "closed"]}, "company_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CMP-[A-Z0-9-]{3,48}$"}}}},
    "supportCase": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "environment_id", "company_id", "project_id", "priority", "status", "summary"], "properties": {"id": {"type": "string", "pattern": "^SUP-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "environment_id": {"type": "string", "pattern": "^ENV-[A-Z0-9-]{3,48}$"}, "company_id": {"type": ["string", "null"], "pattern": "^CMP-[A-Z0-9-]{3,48}$"}, "project_id": {"type": ["string", "null"], "pattern": "^PRJ-[A-Z0-9-]{3,48}$"}, "priority": {"type": "string", "enum": ["P1", "P2", "P3", "P4"]}, "status": {"type": "string", "enum": ["open", "triage", "in-progress", "resolved", "closed"]}, "summary": {"type": "string", "minLength": 3}}},
    "person": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "display_name", "identity_source", "status"], "properties": {"id": {"type": "string", "pattern": "^PEO-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "display_name": {"type": "string", "minLength": 3}, "identity_source": {"type": "string", "enum": ["customer-workspace"]}, "status": {"type": "string", "enum": ["active", "inactive"]}}},
    "roleAssignment": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "scope_type", "scope_id", "role_key", "occupant_status", "person_id", "permissions"], "properties": {"id": {"type": "string", "pattern": "^ROL-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "scope_type": {"type": "string", "enum": ["customer", "environment", "company", "project", "support"]}, "scope_id": {"type": "string"}, "role_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,48}$"}, "occupant_status": {"type": "string", "enum": ["assigned", "pending", "unknown"]}, "person_id": {"type": ["string", "null"], "pattern": "^PEO-[A-Z0-9-]{3,48}$"}, "permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["execution", "internal-decision", "customer-uat-acceptance", "tax-legal-confirmation", "support-acceptance"]}}}},
    "knowledge": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "scope_type", "scope_id", "title", "status", "source_refs"], "properties": {"id": {"type": "string", "pattern": "^KNO-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "scope_type": {"type": "string", "enum": ["customer", "environment", "company", "project", "support"]}, "scope_id": {"type": "string"}, "title": {"type": "string", "minLength": 3}, "status": {"type": "string", "enum": ["draft", "validated", "candidate", "archived"]}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "scope_type", "scope_id", "currency", "planned_hours", "actual_hours", "forecast_hours", "planned_amount", "actual_amount", "forecast_amount", "truth_boundary"], "properties": {"id": {"type": "string", "pattern": "^BUD-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "scope_type": {"type": "string", "enum": ["customer", "project", "support"]}, "scope_id": {"type": "string"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "planned_hours": {"type": "number", "minimum": 0}, "actual_hours": {"type": "number", "minimum": 0}, "forecast_hours": {"type": "number", "minimum": 0}, "planned_amount": {"type": "number", "minimum": 0}, "actual_amount": {"type": "number", "minimum": 0}, "forecast_amount": {"type": "number", "minimum": 0}, "truth_boundary": {"type": "string", "enum": ["project-forecast-not-accounting"]}}},
    "commitment": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "scope_type", "scope_id", "title", "status", "due_date", "acceptance_status"], "properties": {"id": {"type": "string", "pattern": "^DLV-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"}, "scope_type": {"type": "string", "enum": ["customer", "project", "support"]}, "scope_id": {"type": "string"}, "title": {"type": "string", "minLength": 3}, "status": {"type": "string", "enum": ["planned", "in-progress", "delivered", "cancelled"]}, "due_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "acceptance_status": {"type": "string", "enum": ["not-requested", "pending", "accepted", "rejected"]}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["id", "from_id", "to_id", "type", "inverse_relation_id"], "properties": {"id": {"type": "string", "pattern": "^REL-[A-Z0-9-]{3,60}$"}, "from_id": {"type": "string"}, "to_id": {"type": "string"}, "type": {"type": "string", "enum": ["customer-environment", "environment-customer", "environment-company", "company-environment", "customer-project", "project-customer", "customer-support", "support-customer", "company-project", "project-company"]}, "inverse_relation_id": {"type": "string", "pattern": "^REL-[A-Z0-9-]{3,60}$"}}}
  }
}
