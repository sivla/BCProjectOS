{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bcprojectos.invalid/schemas/engagement-fit-standard.schema.json",
  "title": "Spectra Engagement and Fit-to-Standard",
  "type": "object",
  "required": ["schema_version", "contract_version", "record_type", "engagement_id", "product_id", "project_id", "customer_id", "profile", "classification", "synthetic", "offer", "scope_items", "exclusions", "assumptions", "phases", "deliverables", "roles", "raci", "gates", "processes", "use_cases", "assessments", "decisions", "open_questions", "truth_boundary", "readiness"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "record_type": {"const": "engagement-fit-standard"},
    "engagement_id": {"type": "string", "pattern": "^ENG-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "product_id": {"const": "spectra"},
    "project_id": {"type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "profile": {"enum": ["implementation", "support-only"]},
    "classification": {"enum": ["product-template", "synthetic-fixture", "customer-source-of-truth"]},
    "synthetic": {"type": "boolean"},
    "offer": {"$ref": "#/$defs/offer"},
    "scope_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scopeItem"}},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assumption"}},
    "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
    "deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deliverable"}},
    "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/role"}},
    "raci": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/raci"}},
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "processes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/process"}},
    "use_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/useCase"}},
    "assessments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assessment"}},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/openQuestion"}},
    "truth_boundary": {"$ref": "#/$defs/truthBoundary"},
    "readiness": {"$ref": "#/$defs/readiness"}
  },
  "additionalProperties": false,
  "$defs": {
    "offer": {
      "type": "object",
      "required": ["offer_id", "version", "status", "currency", "planned_hours", "planned_cost", "valid_from", "valid_to", "change_history"],
      "properties": {
        "offer_id": {"type": "string", "pattern": "^OFR-[A-Z0-9-]+$"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "approved", "superseded", "closed"]},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "planned_hours": {"type": "number", "minimum": 0},
        "planned_cost": {"type": "number", "minimum": 0},
        "valid_from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "valid_to": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "change_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/offerRevision"}}
      },
      "additionalProperties": false
    },
    "offerRevision": {
      "type": "object",
      "required": ["version", "status", "planned_hours", "planned_cost", "valid_from", "valid_to", "change_reason", "scope_ids"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "approved", "superseded", "closed"]},
        "planned_hours": {"type": "number", "minimum": 0},
        "planned_cost": {"type": "number", "minimum": 0},
        "valid_from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "valid_to": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "change_reason": {"type": "string", "minLength": 1},
        "scope_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "scopeItem": {
      "type": "object",
      "required": ["scope_id", "category", "title", "outcome", "planned_hours", "planned_cost", "acceptance_criteria", "assumption_ids", "deliverable_ids"],
      "properties": {
        "scope_id": {"type": "string", "pattern": "^SCP-[A-Z0-9-]+$"},
        "category": {"enum": ["project-management", "business-process", "configuration", "migration", "integration", "reporting", "testing", "training", "cutover", "support"]},
        "title": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["in-scope", "out-of-scope", "optional"]},
        "planned_hours": {"type": "number", "minimum": 0},
        "planned_cost": {"type": "number", "minimum": 0},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assumption_ids": {"type": "array", "items": {"type": "string"}},
        "deliverable_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": ["exclusion_id", "title", "reason"],
      "properties": {
        "exclusion_id": {"type": "string", "pattern": "^EXC-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": ["assumption_id", "statement", "owner_role", "status", "source_refs"],
      "properties": {
        "assumption_id": {"type": "string", "pattern": "^ASM-[A-Z0-9-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string"},
        "status": {"enum": ["proposed", "confirmed", "rejected", "open"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": ["phase_id", "sequence", "name", "status", "start_date", "end_date"],
      "properties": {
        "phase_id": {"type": "string", "pattern": "^PHA-[A-Z0-9-]+$"},
        "sequence": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "active", "completed", "blocked"]},
        "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      },
      "additionalProperties": false
    },
    "deliverable": {
      "type": "object",
      "required": ["deliverable_id", "phase_id", "title", "status", "due_date", "acceptance_criteria", "evidence_refs"],
      "properties": {
        "deliverable_id": {"type": "string", "pattern": "^DLV-[A-Z0-9-]+$"},
        "phase_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "in-progress", "accepted", "rejected"]},
        "due_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["role_id", "name", "side", "accountability"],
      "properties": {
        "role_id": {"type": "string", "pattern": "^ROL-[A-Z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "side": {"enum": ["customer", "delivery", "shared", "synthetic"]},
        "accountability": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "raci": {
      "type": "object",
      "required": ["deliverable_id", "role_id", "responsibility"],
      "properties": {
        "deliverable_id": {"type": "string"},
        "role_id": {"type": "string"},
        "responsibility": {"enum": ["R", "A", "C", "I"]}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["gate_id", "phase_id", "due_date", "criteria", "status", "decision_id", "evidence_refs"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^GAT-[A-Z0-9-]+$"},
        "phase_id": {"type": "string"},
        "due_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["planned", "passed", "failed", "blocked"]},
        "decision_id": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "required": ["process_id", "bc_area", "name", "owner_role", "steps"],
      "properties": {
        "process_id": {"type": "string", "pattern": "^PRO-[A-Z0-9-]+$"},
        "bc_area": {"enum": ["finance", "p2p", "o2c", "cash-bank", "inventory", "project-management", "cross-functional"]},
        "name": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/processStep"}}
      },
      "additionalProperties": false
    },
    "processStep": {
      "type": "object",
      "required": ["step_id", "sequence", "actor_role", "action", "outcome"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^PST-[A-Z0-9-]+$"},
        "sequence": {"type": "integer", "minimum": 1},
        "actor_role": {"type": "string"},
        "action": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "useCase": {
      "type": "object",
      "required": ["use_case_id", "process_id", "title", "preconditions", "scenario", "expected_outcome"],
      "properties": {
        "use_case_id": {"type": "string", "pattern": "^UCS-[A-Z0-9-]+$"},
        "process_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "scenario": {"type": "string", "minLength": 1},
        "expected_outcome": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["assessment_id", "process_id", "use_case_id", "fit_status", "treatment", "business_need", "standard_capability", "options", "recommended_option_id", "decision_id", "assumption_ids", "scope_ids", "deliverable_ids", "evidence_refs", "status"],
      "properties": {
        "assessment_id": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
        "process_id": {"type": "string"},
        "use_case_id": {"type": "string"},
        "fit_status": {"enum": ["fit", "partial", "gap", "unresolved"]},
        "treatment": {"enum": ["standard", "configuration", "extension", "process-change", "integration", "reporting", "open-question"]},
        "business_need": {"type": "string", "minLength": 1},
        "standard_capability": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/option"}},
        "recommended_option_id": {"type": "string"},
        "decision_id": {"type": ["string", "null"]},
        "assumption_ids": {"type": "array", "items": {"type": "string"}},
        "scope_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "deliverable_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["proposed", "decided", "open"]}
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["option_id", "title", "impact"],
      "properties": {
        "option_id": {"type": "string", "pattern": "^OPT-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["decision_id", "title", "status", "owner_role", "rationale", "selected_option_id", "evidence_refs", "decided_at"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^DEC-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "approved", "rejected", "superseded"]},
        "owner_role": {"type": "string"},
        "rationale": {"type": "string", "minLength": 1},
        "selected_option_id": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decided_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "openQuestion": {
      "type": "object",
      "required": ["question_id", "category", "question", "owner_role", "due_date", "status", "blocks_gate", "answer", "decision_id", "related_ids", "source_refs"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^QUE-[A-Z0-9-]+$"},
        "category": {"enum": ["customer", "tax", "legal", "security", "technical"]},
        "question": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string"},
        "due_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "status": {"enum": ["open", "answered", "blocked", "deferred"]},
        "blocks_gate": {"type": "boolean"},
        "answer": {"type": ["string", "null"]},
        "decision_id": {"type": ["string", "null"]},
        "related_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "truthBoundary": {
      "type": "object",
      "required": ["source_of_truth", "customer_data_in_product", "external_activity_claim", "tax_or_legal_advice_claim"],
      "properties": {
        "source_of_truth": {"enum": ["customer-workspace", "synthetic-fixture", "product-template"]},
        "customer_data_in_product": {"const": false},
        "external_activity_claim": {"const": false},
        "tax_or_legal_advice_claim": {"const": false}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["status", "calculated", "blocking_reasons"],
      "properties": {
        "status": {"enum": ["draft", "blocked", "fit_to_standard_ready"]},
        "calculated": {"const": true},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
