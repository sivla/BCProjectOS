{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://spectra.local/schemas/portable-project-snapshot.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","product_id","snapshot_id","customer_id","project_id","released_at","immutable","provenance","source_inventory","deltas","tombstones","knowledge_change_sets","coverage_matrix","contradictions","brownfield_reconciliation","views"],
  "properties":{
    "schema_version":{"const":1},"product_id":{"const":"spectra"},"snapshot_id":{"type":"string","pattern":"^SNP-[A-Z0-9-]+$"},"customer_id":{"type":"string","pattern":"^CUS-[A-Z0-9-]+$"},"project_id":{"type":"string","pattern":"^PRJ-[A-Z0-9-]+$"},"released_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},"immutable":{"const":true},
    "provenance":{"$ref":"#/$defs/provenance"},"source_inventory":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},"deltas":{"type":"array","items":{"$ref":"#/$defs/delta"}},"tombstones":{"type":"array","items":{"$ref":"#/$defs/tombstone"}},"knowledge_change_sets":{"type":"array","items":{"$ref":"#/$defs/changeSet"}},"coverage_matrix":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/coverage"}},"contradictions":{"type":"array","items":{"$ref":"#/$defs/contradiction"}},"brownfield_reconciliation":{"$ref":"#/$defs/brownfield"},"views":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/view"}}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"relative":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "provenance":{"type":"object","additionalProperties":false,"required":["generated_at","source_inventory_digest","source_commit"],"properties":{"generated_at":{"type":"string","pattern":"^[0-9]{4}-"},"source_inventory_digest":{"$ref":"#/$defs/hash"},"source_commit":{"type":["string","null"],"pattern":"^[a-f0-9]{40}$"}}},
    "attachment":{"type":"object","additionalProperties":false,"required":["attachment_id","file_name","sha256"],"properties":{"attachment_id":{"type":"string","minLength":1},"file_name":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/hash"}}},
    "source":{"type":"object","additionalProperties":false,"required":["source_id","source_type","stable_object_id","source_version","content_sha256","space_id","parent_id","sync_checkpoint","relative_origin","attachments"],"properties":{"source_id":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"},"source_type":{"enum":["confluence-page","jira-object","filesystem-document","repository-object"]},"stable_object_id":{"type":"string","minLength":1},"source_version":{"type":"string","minLength":1},"content_sha256":{"$ref":"#/$defs/hash"},"space_id":{"type":["string","null"]},"parent_id":{"type":["string","null"]},"sync_checkpoint":{"type":"string","minLength":1},"relative_origin":{"$ref":"#/$defs/relative"},"attachments":{"type":"array","items":{"$ref":"#/$defs/attachment"}}}},
    "delta":{"type":"object","additionalProperties":false,"required":["delta_id","source_id","delta_type","before_digest","after_digest"],"properties":{"delta_id":{"type":"string","pattern":"^DEL-[A-Z0-9-]+$"},"source_id":{"type":"string","minLength":1},"delta_type":{"enum":["added","modified","renamed","moved","deleted","inaccessible","conflicted"]},"before_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"after_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}}},
    "tombstone":{"type":"object","additionalProperties":false,"required":["tombstone_id","source_id","delta_id","reason","recorded_at"],"properties":{"tombstone_id":{"type":"string","pattern":"^TMB-[A-Z0-9-]+$"},"source_id":{"type":"string","minLength":1},"delta_id":{"type":"string","minLength":1},"reason":{"enum":["deleted","inaccessible"]},"recorded_at":{"type":"string","pattern":"^[0-9]{4}-"}}},
    "changeSet":{"type":"object","additionalProperties":false,"required":["change_set_id","source_ids","review_status","projected_as_truth","reviewer_role","artifact_refs"],"properties":{"change_set_id":{"type":"string","pattern":"^KCS-[A-Z0-9-]+$"},"source_ids":{"type":"array","minItems":1,"items":{"type":"string"}},"review_status":{"enum":["pending","accepted","rejected","deferred"]},"projected_as_truth":{"type":"boolean"},"reviewer_role":{"type":"string","minLength":1},"artifact_refs":{"type":"array","items":{"type":"string"}}}},
    "coverage":{"type":"object","additionalProperties":false,"required":["area","expected","covered","status"],"properties":{"area":{"type":"string","minLength":1},"expected":{"type":"integer","minimum":0},"covered":{"type":"integer","minimum":0},"status":{"enum":["complete","partial","open"]}}},
    "contradiction":{"type":"object","additionalProperties":false,"required":["contradiction_id","source_ids","status","owner_role"],"properties":{"contradiction_id":{"type":"string","pattern":"^CON-[A-Z0-9-]+$"},"source_ids":{"type":"array","minItems":2,"items":{"type":"string"}},"status":{"enum":["open","resolved","accepted-risk"]},"owner_role":{"type":"string","minLength":1}}},
    "importRow":{"type":"object","additionalProperties":false,"required":["artifact_id","source_id","decision","owner_role","workshop_ref","baseline_status","open_gap"],"properties":{"artifact_id":{"type":"string","minLength":1},"source_id":{"type":"string","minLength":1},"decision":{"enum":["import","exclude","review"]},"owner_role":{"type":"string","minLength":1},"workshop_ref":{"type":"string","minLength":1},"baseline_status":{"enum":["known","partial","unknown"]},"open_gap":{"type":["string","null"]}}},
    "brownfield":{"type":"object","additionalProperties":false,"required":["baseline_id","import_matrix","open_gaps"],"properties":{"baseline_id":{"type":"string","minLength":1},"import_matrix":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/importRow"}},"open_gaps":{"type":"array","items":{"type":"string"}}}},
    "view":{"type":"object","additionalProperties":false,"required":["view_id","audience","artifact_refs"],"properties":{"view_id":{"type":"string","minLength":1},"audience":{"enum":["internal","customer-specific"]},"artifact_refs":{"type":"array","items":{"type":"string"}}}}
  }
}
