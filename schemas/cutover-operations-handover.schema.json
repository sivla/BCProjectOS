    "support":{"type":"object","additionalProperties":false,"required":["id","owner_role","known_issues","backlog_refs","escalation_path","evidence_refs","accepted"],"properties":{"id":{"const":"SUP-ACCEPT-01"},"owner_role":{"type":"string","pattern":"^ROLE-[A-Z0-9-]+$"},"known_issues":{"type":"array","items":{"type":"string"}},"backlog_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^HC-[A-Z0-9-]+$"}},"escalation_path":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"accepted":{"const":true}}},
    "handover":{"type":"object","additionalProperties":false,"required":["id","support_acceptance_ref","hypercare_exit","open_p1","open_p2","evidence_refs","decision","known_limits"],"properties":{"id":{"const":"HND-01"},"support_acceptance_ref":{"const":"SUP-ACCEPT-01"},"hypercare_exit":{"const":true},"open_p1":{"const":0},"open_p2":{"const":0},"evidence_refs":{"type":"array","minItems":2,"items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"decision":{"const":"ACCEPTED"},"known_limits":{"type":"array","minItems":1,"items":{"type":"string"}}}}
