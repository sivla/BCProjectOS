    "evidence":{"type":"object","additionalProperties":false,"required":["id","type","sha256","synthetic","external_activity"],"properties":{"id":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"},"type":{"enum":["uat_exit","mock_cutover","go_no_go","hypercare_daily","fix","retest","backup_restore","support_acceptance","handover"]},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"synthetic":{"const":true},"external_activity":{"const":false}}},
    "task":{"type":"object","additionalProperties":false,"required":["id","sequence","title","owner_role","depends_on","window","entry_criteria","exit_criteria","evidence_refs","status"],"properties":{"id":{"type":"string","pattern":"^CUT-[A-Z0-9-]+$"},"sequence":{"type":"integer","minimum":1},"title":{"type":"string","minLength":1},"owner_role":{"type":"string","pattern":"^ROLE-[A-Z0-9-]+$"},"depends_on":{"type":"array","items":{"type":"string","pattern":"^CUT-[A-Z0-9-]+$"}},"window":{"type":"string","minLength":1},"entry_criteria":{"type":"array","minItems":1,"items":{"type":"string"}},"exit_criteria":{"type":"array","minItems":1,"items":{"type":"string"}},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"status":{"enum":["planned","completed","blocked"]}}},
    "mock":{"type":"object","additionalProperties":false,"required":["id","task_refs","planned_minutes","actual_minutes","variance_reason","evidence_refs","status"],"properties":{"id":{"const":"MOCK-CUTOVER-01"},"task_refs":{"type":"array","minItems":6,"items":{"type":"string","pattern":"^CUT-[A-Z0-9-]+$"}},"planned_minutes":{"type":"number","minimum":1},"actual_minutes":{"type":"number","minimum":1},"variance_reason":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"status":{"const":"passed"}}},
    "gate":{"type":"object","additionalProperties":false,"required":["id","decision","criteria_met","open_p1","open_p2","owner_role","evidence_refs","conditions"],"properties":{"id":{"const":"GATE-GO-LIVE"},"decision":{"enum":["GO","NO_GO","GO_WITH_CONDITIONS"]},"criteria_met":{"type":"boolean"},"open_p1":{"type":"integer","minimum":0},"open_p2":{"type":"integer","minimum":0},"owner_role":{"type":"string","pattern":"^ROLE-[A-Z0-9-]+$"},"evidence_refs":{"type":"array","minItems":2,"items":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}},"conditions":{"type":"array","items":{"type":"string"}}}},
    "issue":{"type":"object","additionalProperties":false,"required":["id","priority","status","diagnosis","fix","retest_evidence_ref"],"properties":{"id":{"type":"string","pattern":"^HC-[A-Z0-9-]+$"},"priority":{"enum":["P1","P2","P3","P4"]},"status":{"enum":["open","fixed","retested","closed"]},"diagnosis":{"type":"string","minLength":1},"fix":{"type":"string","minLength":1},"retest_evidence_ref":{"type":"string","pattern":"^EVD-[A-Z0-9-]+$"}}},
