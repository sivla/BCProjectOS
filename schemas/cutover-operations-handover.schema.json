{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://local.bcprojectos.invalid/schemas/cutover-operations-handover.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","product_id","profile","program_id","simulation_boundary","roles","evidence","uat_exit_ref","cutover_tasks","mock_cutover","go_live_gate","hypercare_days","restart_plan","support_acceptance","handover"],
  "properties":{
    "schema_version":{"const":1},"product_id":{"const":"spectra"},"profile":{"enum":["implementation","support-only"]},"program_id":{"type":"string","pattern":"^SYN-OPS-[A-Z0-9-]+$"},"simulation_boundary":{"const":"synthetic_non_production"},
    "roles":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/role"}},"evidence":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/evidence"}},"uat_exit_ref":{"type":"string","pattern":"^DEC-UAT-[A-Z0-9-]+$"},
    "cutover_tasks":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/task"}},"mock_cutover":{"$ref":"#/$defs/mock"},"go_live_gate":{"$ref":"#/$defs/gate"},"hypercare_days":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/day"}},"restart_plan":{"$ref":"#/$defs/restart"},"support_acceptance":{"$ref":"#/$defs/support"},"handover":{"$ref":"#/$defs/handover"}
