{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/spectra-project-registry.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "product_id", "registry_id", "created_at", "entries"],
  "properties": {
    "schema_version": {"const": 1}, "product_id": {"const": "spectra"},
    "registry_id": {"type": "string", "pattern": "^REG-[A-Z0-9-]{3,60}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace_id", "customer_id", "project_id", "profile", "mode", "relative_path", "release_version", "release_tag", "release_commit", "release_tree", "release_digest", "registered_at", "status"],
      "properties": {
        "workspace_id": {"type": "string", "pattern": "^WS-[A-Z0-9-]{3,60}$"},
        "customer_id": {"type": "string", "pattern": "^CUS-[0-9A-HJKMNP-TV-Z]{26}$"},
        "project_id": {"type": ["string", "null"], "pattern": "^PRJ-[A-Z0-9-]{3,60}$"},
        "profile": {"enum": ["implementation", "support-only"]},
        "mode": {"enum": ["new", "adopted"]},
        "relative_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "release_version": {"type": "string", "minLength": 1}, "release_tag": {"type": "string", "pattern": "^spectra-v"},
        "release_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "release_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "release_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "registered_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"}, "status": {"const": "active"}
      }
    }
  }
}
