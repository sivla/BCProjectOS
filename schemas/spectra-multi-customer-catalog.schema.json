{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://spectra.local/schemas/spectra-multi-customer-catalog.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","product_id","catalog_id","generated_at","customers"],
  "properties":{"schema_version":{"const":1},"product_id":{"const":"spectra"},"catalog_id":{"type":"string","pattern":"^MCC-[A-Z0-9-]+$"},"generated_at":{"type":"string","pattern":"^[0-9]{4}-"},"customers":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/customer"}}},
  "$defs":{"customer":{"type":"object","additionalProperties":false,"required":["customer_id","visibility","projects"],"properties":{"customer_id":{"type":"string","pattern":"^CUS-[A-Z0-9-]+$"},"visibility":{"const":"isolated"},"projects":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/project"}}}},"project":{"type":"object","additionalProperties":false,"required":["project_id","release_manifest_path","release_id","snapshot_sha256"],"properties":{"project_id":{"type":"string","pattern":"^PRJ-[A-Z0-9-]+$"},"release_manifest_path":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"release_id":{"type":"string","minLength":1},"snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
}
