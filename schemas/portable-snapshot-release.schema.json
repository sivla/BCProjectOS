{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://spectra.local/schemas/portable-snapshot-release.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","product_id","release_id","snapshot_id","customer_id","project_id","state","immutable","snapshot_path","snapshot_sha256","transports"],
  "properties":{"schema_version":{"const":1},"product_id":{"const":"spectra"},"release_id":{"type":"string","pattern":"^SRL-[A-Z0-9-]+$"},"snapshot_id":{"type":"string","minLength":1},"customer_id":{"type":"string","minLength":1},"project_id":{"type":"string","minLength":1},"state":{"const":"approved"},"immutable":{"const":true},"snapshot_path":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"transports":{"type":"object","additionalProperties":false,"required":["contract_id","media_type","filesystem","http"],"properties":{"contract_id":{"const":"spectra-portable-project-snapshot-v1"},"media_type":{"const":"application/vnd.spectra.project-snapshot+json"},"filesystem":{"$ref":"#/$defs/transport"},"http":{"$ref":"#/$defs/transport"}}}},
  "$defs":{"transport":{"type":"object","additionalProperties":false,"required":["location","payload_sha256"],"properties":{"location":{"type":"string","minLength":1},"payload_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"content_base64":{"type":"string","minLength":4}}}}
}
