{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/spectra-twin-handoff.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "product_id", "workspace_id", "customer_id", "project_id", "snapshot_id", "release_manifest_path", "snapshot_path", "snapshot_sha256", "release_version", "release_commit", "created_at", "read_only"],
  "properties": {
    "schema_version": {"const": 1}, "product_id": {"const": "spectra"},
    "workspace_id": {"type": "string", "pattern": "^WS-[A-Z0-9-]{3,60}$"},
    "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]+$"},
    "project_id": {"type": "string", "pattern": "^PRJ-[A-Z0-9-]+$"},
    "snapshot_id": {"type": "string", "pattern": "^SNP-[A-Z0-9-]+$"},
    "release_manifest_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "snapshot_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_version": {"type": "string", "minLength": 1}, "release_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"}, "read_only": {"const": true}
  }
}
