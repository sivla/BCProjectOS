{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.invalid/schemas/knowledge-inbox.schema.json",
  "title": "Spectra Knowledge Inbox",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "record_type", "classification", "customer_id", "foundation_digest", "intake_items", "observations", "meeting_packages", "comparison_runs", "proposals", "review_decisions", "conflicts", "writes_performed", "target_mutation"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "product_id": {"type": "string", "enum": ["spectra"]},
    "record_type": {"type": "string", "enum": ["knowledge-inbox"]},
    "classification": {"type": "string", "enum": ["synthetic-fixture", "customer-workspace"]},
    "lifecycle_authority": {"type": "string", "enum": ["foundation-read-only"]},
    "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"},
    "foundation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "intake_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/intake"}},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "meeting_packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/meeting"}},
    "comparison_runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/comparison"}},
    "proposals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proposal"}},
    "review_decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "writes_performed": {"type": "boolean", "enum": [false]},
    "target_mutation": {"type": "boolean", "enum": [false]}
  },
  "$defs": {
    "intake": {"type": "object", "additionalProperties": false, "required": ["id", "customer_id", "source_system", "source_object_id", "source_revision", "source_path", "sha256", "source_hash_after", "size_bytes", "media_type", "classification", "imported_at", "status"], "properties": {"id": {"type": "string", "pattern": "^INT-[A-Z0-9-]{3,48}$"}, "customer_id": {"type": "string"}, "source_system": {"type": "string", "enum": ["local-file", "meeting-export", "data-sample"]}, "source_object_id": {"type": "string", "minLength": 3}, "source_revision": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_hash_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}, "media_type": {"type": "string", "minLength": 3}, "classification": {"type": "string", "enum": ["synthetic", "internal", "confidential"]}, "imported_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"}, "status": {"type": "string", "enum": ["captured", "processed", "quarantined"]}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["id", "intake_id", "occurred_at", "summary", "certainty", "scope_type", "scope_id", "source_revision"], "properties": {"id": {"type": "string", "pattern": "^OBS-[A-Z0-9-]{3,48}$"}, "intake_id": {"type": "string"}, "occurred_at": {"type": "string"}, "summary": {"type": "string", "minLength": 3}, "certainty": {"type": "string", "enum": ["observed", "unknown", "unavailable"]}, "scope_type": {"type": "string", "enum": ["customer", "environment", "company", "project", "support"]}, "scope_id": {"type": "string"}, "source_revision": {"type": "string"}}},
    "meeting": {"type": "object", "additionalProperties": false, "required": ["id", "intake_ids", "observation_ids", "status"], "properties": {"id": {"type": "string", "pattern": "^MTG-[A-Z0-9-]{3,48}$"}, "intake_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "status": {"type": "string", "enum": ["draft", "ready-for-review", "reviewed"]}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["id", "foundation_digest", "baseline_digest", "run_at", "status", "stale", "observation_ids", "proposal_ids"], "properties": {"id": {"type": "string", "pattern": "^CMP-RUN-[A-Z0-9-]{3,48}$"}, "foundation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "baseline_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "run_at": {"type": "string"}, "status": {"type": "string", "enum": ["complete", "blocked"]}, "stale": {"type": "boolean"}, "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "proposal_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["id", "comparison_id", "target_type", "target_id", "operation", "expected_foundation_digest", "observation_ids", "summary", "status", "writes_performed"], "properties": {"id": {"type": "string", "pattern": "^PRO-[A-Z0-9-]{3,48}$"}, "comparison_id": {"type": "string"}, "target_type": {"type": "string", "enum": ["customer", "environment", "company", "project", "support", "knowledge", "budget", "commitment"]}, "target_id": {"type": "string"}, "operation": {"type": "string", "enum": ["create", "update", "link"]}, "expected_foundation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "summary": {"type": "string", "minLength": 3}, "status": {"type": "string", "enum": ["proposed", "accepted", "rejected", "deferred", "conflicted"]}, "writes_performed": {"type": "boolean", "enum": [false]}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "proposal_id", "actor_type", "person_id", "acting_role_id", "decision", "decided_at", "reason", "execution_plan_id", "writes_performed"], "properties": {"id": {"type": "string", "pattern": "^REV-[A-Z0-9-]{3,48}$"}, "proposal_id": {"type": "string"}, "actor_type": {"type": "string", "enum": ["human", "playwright", "codex-spectra", "system"]}, "person_id": {"type": ["string", "null"], "pattern": "^PEO-[A-Z0-9-]{3,48}$"}, "acting_role_id": {"type": "string", "pattern": "^ROL-[A-Z0-9-]{3,48}$"}, "decision": {"type": "string", "enum": ["accepted", "rejected", "deferred"]}, "decided_at": {"type": "string"}, "reason": {"type": "string", "minLength": 3}, "execution_plan_id": {"type": "null"}, "writes_performed": {"type": "boolean", "enum": [false]}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["id", "proposal_ids", "reason", "status"], "properties": {"id": {"type": "string", "pattern": "^CNF-[A-Z0-9-]{3,48}$"}, "proposal_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "reason": {"type": "string", "minLength": 3}, "status": {"type": "string", "enum": ["open", "resolved"]}}}
  }
}
