{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/existing-project-adoption-plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "product_id", "plan_id", "config_id", "discovery_id", "source_revision", "discovery_sha256", "created_at", "operations", "remote_mutation_allowed", "plan_digest"],
  "properties": {
    "schema_version": {"const": 1}, "product_id": {"const": "spectra"},
    "plan_id": {"type": "string", "pattern": "^ADP-[A-Z0-9-]{3,60}$"}, "config_id": {"type": "string", "minLength": 3}, "discovery_id": {"type": "string", "minLength": 3},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "discovery_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "remote_mutation_allowed": {"const": false}, "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "operation": {"type": "object", "additionalProperties": false, "required": ["id", "class", "domain", "source_ref", "target", "reason", "remote_action"], "properties": {"id": {"type": "string", "pattern": "^OP-[A-Z0-9-]+$"}, "class": {"enum": ["adopt-as-is", "explicit-map", "improvement-proposal"]}, "domain": {"enum": ["workspace", "jira-issue-type", "jira-status", "jira-field", "confluence-space", "improvement"]}, "source_ref": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 3}, "remote_action": {"const": "none"}}}
  }
}
