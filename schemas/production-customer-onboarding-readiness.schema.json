{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.invalid/schemas/production-customer-onboarding-readiness.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","product_id","customer_id","workspace_id","project_id","project_type","product_binding","business_central","atlassian","data_boundary","recovery"],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"const": "spectra"},
    "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]{3,48}$"},
    "workspace_id": {"type": "string", "pattern": "^WS-[A-Z0-9-]{3,48}$"},
    "project_id": {"type": "string", "pattern": "^PRJ-[A-Z0-9-]{3,48}$"},
    "project_type": {"enum": ["implementation","support-only","fit-gap","migration"]},
    "predecessor": {"type": ["null","object"], "additionalProperties": false, "required": ["customer_id","project_id"], "properties": {"customer_id":{"type":"string"},"project_id":{"type":"string"}}},
    "product_binding": {"type":"object","additionalProperties":false,"required":["version","release_tag","manifest_path"],"properties":{"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},"release_tag":{"type":"string","pattern":"^spectra-v"},"manifest_path":{"type":"string","pattern":"^release/versions/[^/]+/release-manifest\\.json$"}}},
    "business_central": {"type":"object","additionalProperties":false,"required":["operation_mode","country","localization","environment_roles"],"properties":{"operation_mode":{"enum":["online","on-prem"]},"country":{"type":"string","pattern":"^[A-Z]{2}$"},"localization":{"type":"string","minLength":2},"environment_roles":{"type":"array","minItems":1,"items":{"enum":["sandbox","production","development","test"]}}}},
    "atlassian": {"type":"object","additionalProperties":false,"required":["mode","live_apply"],"properties":{"mode":{"enum":["simulated","manual-materialization"]},"live_apply":{"const":false}}},
    "data_boundary": {"type":"object","additionalProperties":false,"required":["classification","retention_policy","external_file_intake","secret_references"],"properties":{"classification":{"enum":["synthetic","internal","confidential"]},"retention_policy":{"type":"string","minLength":3},"external_file_intake":{"enum":["proposal-only","disabled"]},"secret_references":{"type":"array","items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,80}$"}}}},
    "recovery": {"type":"object","additionalProperties":false,"required":["backup_required","restore_test_required","uninstall_preserves_workspace"],"properties":{"backup_required":{"const":true},"restore_test_required":{"const":true},"uninstall_preserves_workspace":{"const":true}}}
  }
}
