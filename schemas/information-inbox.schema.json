{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectra Information Inbox and Proposal Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "workspace_id", "customer_id", "project_id", "support_case_id", "intake_items", "observations", "proposals", "audit_events", "snapshots", "target_artifacts"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "product_id": {"type": "string", "enum": ["spectra"]},
    "workspace_id": {"type": "string"},
    "customer_id": {"type": "string"},
    "project_id": {"type": ["string", "null"]},
    "support_case_id": {"type": ["string", "null"]},
    "intake_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/intake"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
    "audit_events": {"type": "array", "items": {"$ref": "#/$defs/audit"}},
    "snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}},
    "target_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target_artifact"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_system", "source_object_id", "revision", "sha256", "relative_path", "observed_at", "imported_at", "actor_role", "classification", "sensitivity"],
      "properties": {
        "source_system": {"type": "string", "enum": ["file", "meeting", "transcript", "process_description", "support_case", "bc_finding", "repository"]},
        "source_object_id": {"type": "string"}, "revision": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "relative_path": {"type": "string"}, "observed_at": {"type": "string"}, "imported_at": {"type": "string"},
        "actor_role": {"type": "string"},
        "classification": {"type": "string", "enum": ["project_information", "support_information", "technical_finding", "process_information", "meeting_information"]},
        "sensitivity": {"type": "string", "enum": ["public", "internal", "restricted", "blocked"]}
      }
    },
    "intake": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspace_id", "customer_id", "project_id", "support_case_id", "source", "status"],
      "properties": {
        "id": {"type": "string"}, "workspace_id": {"type": "string"}, "customer_id": {"type": "string"},
        "project_id": {"type": ["string", "null"]}, "support_case_id": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/source"}, "status": {"type": "string", "enum": ["captured", "blocked", "processed"]}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["id", "intake_id", "statement", "confidence", "observed_at"],
      "properties": {"id": {"type": "string"}, "intake_id": {"type": "string"}, "statement": {"type": "string"}, "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "observed_at": {"type": "string"}}
    },
    "status_history": {
      "type": "object", "additionalProperties": false, "required": ["status", "at", "actor_role", "event_id"],
      "properties": {"status": {"type": "string", "enum": ["neu", "geprüft", "angenommen", "abgelehnt", "zurückgestellt", "umgesetzt"]}, "at": {"type": "string"}, "actor_role": {"type": "string"}, "event_id": {"type": "string"}}
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "intake_id", "observation_id", "proposer_role", "target_domain", "target_id", "change_type", "rationale", "conflicts", "open_questions", "risk", "reviewer_role", "status_history", "status", "acceptance_event_id", "implementation_event_id", "implementation_evidence"],
      "properties": {
        "id": {"type": "string"}, "intake_id": {"type": "string"}, "observation_id": {"type": "string"}, "proposer_role": {"type": "string"},
        "target_domain": {"type": "string", "enum": ["ticket", "page", "budget", "project_status", "technical_documentation", "support_case", "knowledge"]},
        "target_id": {"type": ["string", "null"]}, "change_type": {"type": "string", "enum": ["create", "update", "link", "no_change"]},
        "rationale": {"type": "string"}, "conflicts": {"type": "array"}, "open_questions": {"type": "array"},
        "risk": {"type": "string", "enum": ["low", "medium", "high"]}, "reviewer_role": {"type": "string"},
        "status_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/status_history"}}, "status": {"type": "string", "enum": ["neu", "geprüft", "angenommen", "abgelehnt", "zurückgestellt", "umgesetzt"]},
        "acceptance_event_id": {"type": ["string", "null"]}, "implementation_event_id": {"type": ["string", "null"]}, "implementation_evidence": {"type": ["string", "null"]}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false, "required": ["id", "event_type", "actor_role", "occurred_at", "source_revision", "before", "after", "decision", "references"],
      "properties": {
        "id": {"type": "string"}, "event_type": {"type": "string", "enum": ["intake", "observation", "proposal_review", "proposal_acceptance", "proposal_implementation", "rejection", "deferral"]},
        "actor_role": {"type": "string"}, "occurred_at": {"type": "string"}, "source_revision": {"type": ["string", "null"]},
        "before": {"type": ["object", "null"]}, "after": {"type": ["object", "null"]}, "decision": {"type": "string"}, "references": {"type": "array"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false, "required": ["id", "source_revision", "created_at", "digest", "read_only"],
      "properties": {"id": {"type": "string"}, "source_revision": {"type": "string"}, "created_at": {"type": "string"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "read_only": {"type": "boolean"}}
    },
    "target_artifact": {
      "type": "object", "additionalProperties": false, "required": ["relative_path", "sha256_before", "sha256_after", "write_status"],
      "properties": {"relative_path": {"type": "string"}, "sha256_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sha256_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "write_status": {"type": "string", "enum": ["unchanged"]}}
    }
  }
}
