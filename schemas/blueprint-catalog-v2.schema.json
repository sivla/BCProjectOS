{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog", "catalog_version", "product_id", "catalog_id", "blueprints", "page_trees"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "catalog": {"type": "string", "const": "blueprint-catalog-v2"},
    "catalog_version": {"type": "string", "const": "2.0"},
    "product_id": {"type": "string", "const": "spectra"},
    "catalog_id": {"type": "string", "pattern": "^blueprint-catalog-[a-z0-9-]+$"},
    "blueprints": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/blueprint"}},
    "page_trees": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/page_tree"}},
    "blueprint_candidates": {"type":"array","items":{"$ref":"#/$defs/candidate"}}
  },
  "$defs": {
    "page_tree": {"type":"object","additionalProperties":false,"required":["space_id","home_node_id","nodes"],"properties":{"space_id":{"type":"string","minLength":1},"home_node_id":{"type":"string","minLength":1},"nodes":{"type":"array","items":{"$ref":"#/$defs/page_node"}}}},
    "page_node": {"type":"object","additionalProperties":false,"required":["node_id","title","order","parent_node_id","content_boundary","leading_location","required_when","allowed_references"],"properties":{"node_id":{"type":"string","pattern":"^node-[a-z0-9-]+$"},"title":{"type":"string","minLength":1},"order":{"type":"integer","minimum":0},"parent_node_id":{"type":["string","null"]},"content_boundary":{"type":"string","enum":["customer","product","consulting"]},"leading_location":{"type":"string","minLength":1},"required_when":{"type":"string","enum":["always","content_available"]},"create_when_content_available":{"type":"boolean"},"allowed_references":{"type":"array","items":{"type":"string"}},"blueprint_content_source":{"type":["string","null"]}}},
    "candidate": {"type":"object","additionalProperties":false,"required":["candidate_id","blueprint_id","review_status","source"],"properties":{"candidate_id":{"type":"string","pattern":"^candidate-[a-z0-9-]+$"},"blueprint_id":{"type":"string"},"review_status":{"type":"string","const":"pending"},"source":{"type":"string","const":"anonymized-structural-finding"}}},
    "blueprint": {
      "type": "object", "additionalProperties": false,
      "required": ["blueprint_id", "version", "kind", "purpose", "leading_location", "required_fields", "optional_fields", "roles", "references", "modules", "provenance", "content_boundaries", "page_tree_refs", "lifecycle"],
      "properties": {
        "blueprint_id": {"type": "string", "pattern": "^bp-[a-z0-9-]+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"type": "string", "enum": ["implementation", "support-only", "bc-basic"]},
        "purpose": {"type": "string", "minLength": 1},
        "leading_location": {"type": "string", "minLength": 1},
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "optional_fields": {"type": "array", "items": {"type": "string"}},
        "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}},
        "content_boundaries": {"type": "object", "additionalProperties": false, "required": ["customer", "product", "consulting"], "properties": {"customer": {"type": "string"}, "product": {"type": "string"}, "consulting": {"type": "string"}}},
        "composition": {"type": "array", "items": {"type": "string"}},
        "page_tree_refs": {"type": "array", "items": {"type": "string"}},
        "lifecycle": {"type": "string", "enum": ["template", "candidate"]},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "revision"], "properties": {"source": {"type": "string", "const": "spectra-catalog"}, "revision": {"type": "string", "minLength": 1}}}
      }
    },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["module_id", "title", "content_mode", "required", "templates", "tickets", "space", "content_boundary"],
      "properties": {
        "module_id": {"type": "string", "pattern": "^mod-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "content_mode": {"type": "string", "enum": ["blank", "example"]},
        "required": {"type": "boolean"},
        "space": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"},
        "content_boundary": {"type": "string", "enum": ["customer", "product", "consulting"]},
        "templates": {"type": "array", "items": {"$ref": "#/$defs/template"}},
        "tickets": {"type": "array", "items": {"$ref": "#/$defs/ticket"}}
      }
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "purpose", "leading_location", "required_fields", "optional_fields", "allowed_references"],
      "properties": {"template_id": {"type": "string", "pattern": "^tpl-[a-z0-9-]+$"}, "purpose": {"type": "string", "minLength": 1}, "leading_location": {"type": "string", "minLength": 1}, "required_fields": {"type": "array", "items": {"type": "string"}}, "optional_fields": {"type": "array", "items": {"type": "string"}}, "allowed_references": {"type": "array", "items": {"type": "string"}}}
    },
    "ticket": {
      "type": "object", "additionalProperties": false,
      "required": ["ticket_id", "type", "billable", "parent_id", "worklog_allowed"],
      "properties": {"ticket_id": {"type": "string", "pattern": "^tpl-ticket-[a-z0-9-]+$"}, "type": {"type": "string", "enum": ["phase", "epic", "story", "bug", "task"]}, "billable": {"type": "boolean"}, "worklog_allowed": {"type": "boolean"}, "parent_id": {"type": ["string", "null"]}}
    }
  }
}
