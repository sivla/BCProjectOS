{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bcprojectos.invalid/schemas/release-manifest.schema.json",
  "title": "BCProjectOS Release Manifest",
  "type": "object",
  "required": ["schema_version","product_id","release_version","release_kind","manifest_state","release_date","expected_tag","source_commit","consumer_mode","installable_blueprint","blueprint_version","payload","binding_requirements","excluded_from_payload","known_limits"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "product_id": {"const": "spectra"},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "release_kind": {"enum": ["product_contract", "installable_blueprint"]},
    "manifest_state": {"enum": ["candidate", "final"]},
    "release_date": {"type": "string", "format": "date"},
    "expected_tag": {"type": "string", "pattern": "^spectra-v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "consumer_mode": {"enum": ["CONTRACT_REFERENCE_ONLY", "INSTALLABLE_BLUEPRINT"]},
    "installable_blueprint": {"type": "boolean"},
    "blueprint_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "payload": {
      "type": "object",
      "required": ["digest_algorithm","bundle_digest","file_count","checksums_file","files"],
      "properties": {
        "digest_algorithm": {"const": "SHA-256"},
        "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "file_count": {"type": "integer", "minimum": 1},
        "checksums_file": {"const": "checksums.sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path","sha256","size_bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "binding_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "excluded_from_payload": {"type": "array", "items": {"type": "string"}},
    "known_limits": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["source_tree"]}
    },
    {
      "if": {"properties": {"manifest_state": {"const": "candidate"}}},
      "then": {
        "properties": {
          "schema_version": {"const": 2},
          "release_kind": {"const": "installable_blueprint"},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "consumer_mode": {"const": "CONTRACT_REFERENCE_ONLY"},
          "installable_blueprint": {"const": false},
          "blueprint_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"}
        }
      }
    },
    {
      "if": {"properties": {"manifest_state": {"const": "final"}}},
      "then": {
        "properties": {
          "release_kind": {"const": "installable_blueprint"},
          "consumer_mode": {"const": "INSTALLABLE_BLUEPRINT"},
          "installable_blueprint": {"const": true},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "blueprint_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"}
        }
      }
    }
  ],
  "additionalProperties": false
}
