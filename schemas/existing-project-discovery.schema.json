{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/existing-project-discovery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "discovery_id", "captured_at", "source_revision", "jira", "confluence"],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"const": "spectra"},
    "discovery_id": {"type": "string", "pattern": "^DSC-[A-Z0-9-]{3,60}$"},
    "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "jira": {"$ref": "#/$defs/jira"},
    "confluence": {"$ref": "#/$defs/confluence"}
  },
  "$defs": {
    "jira": {
      "type": "object", "additionalProperties": false,
      "required": ["base_url", "site_id", "project", "board", "issue_types", "statuses", "fields", "components", "labels"],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https://[^/?#]+$"},
        "site_id": {"type": "string", "minLength": 2},
        "project": {"$ref": "#/$defs/jiraProject"},
        "board": {"$ref": "#/$defs/jiraBoard"},
        "issue_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedLevel"}},
        "statuses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named"}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/named"}},
        "components": {"type": "array", "items": {"$ref": "#/$defs/named"}},
        "labels": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "jiraProject": {"type": ["object", "null"], "additionalProperties": false, "required": ["id", "key", "name"], "properties": {"id": {"type": "string", "minLength": 1}, "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,19}$"}, "name": {"type": "string", "minLength": 2}}},
    "jiraBoard": {"type": "object", "additionalProperties": false, "required": ["id", "name", "project_id", "filter_id"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 2}, "project_id": {"type": ["string", "null"]}, "filter_id": {"type": ["string", "null"]}}},
    "named": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "namedLevel": {"type": "object", "additionalProperties": false, "required": ["id", "name", "hierarchy_level"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "hierarchy_level": {"type": "integer", "minimum": 0}}},
    "confluence": {
      "type": "object", "additionalProperties": false,
      "required": ["base_url", "site_id", "spaces", "pages"],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https://[^/?#]+$"},
        "site_id": {"type": "string", "minLength": 2},
        "spaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/space"}},
        "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}}
      }
    },
    "space": {"type": "object", "additionalProperties": false, "required": ["id", "key", "name"], "properties": {"id": {"type": "string", "minLength": 1}, "key": {"type": "string", "pattern": "^[A-Z0-9_-]{2,30}$"}, "name": {"type": "string", "minLength": 2}}},
    "page": {"type": "object", "additionalProperties": false, "required": ["id", "space_id", "title", "parent_id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "space_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "parent_id": {"type": ["string", "null"]}, "version": {"type": "integer", "minimum": 1}}}
  }
}
