{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/project-init.schema.json",
  "title": "Spectra Project Initialization Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "mode", "project_id", "project_name", "profile", "language", "bc_package", "processes", "collaboration", "project_space", "referenced_spaces"],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"const": "spectra"},
    "mode": {"enum": ["new", "local", "onboard"]},
    "project_id": {"type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{2,47}$"},
    "project_name": {"type": "string", "minLength": 3},
    "profile": {"enum": ["implementation", "support-only"]},
    "language": {"enum": ["de-DE", "en-US"]},
    "bc_package": {"const": "bc-basic-standard"},
    "processes": {"type": "array", "minItems": 1, "items": {"enum": ["finance", "p2p", "o2c", "cash-bank", "inventory", "closing", "vat-preview"]}},
    "collaboration": {"enum": ["local-only", "portable-atlassian", "existing-atlassian-readonly"]},
    "project_space": {"$ref": "#/$defs/space"},
    "referenced_spaces": {"type": "array", "items": {"$ref": "#/$defs/referencedSpace"}},
    "onboarding_source": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "format"], "properties": {"path": {"type": "string", "minLength": 1}, "format": {"const": "spectra-portable-atlassian-v1"}}}
  },
  "$defs": {
    "space": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {"id": {"type": "string", "pattern": "^SPACE-[A-Z0-9-]{3,40}$"}, "title": {"type": "string", "minLength": 3}}},
    "referencedSpace": {"type": "object", "additionalProperties": false, "required": ["id", "title", "read_only"], "properties": {"id": {"type": "string", "pattern": "^SPACE-[A-Z0-9-]{3,40}$"}, "title": {"type": "string", "minLength": 3}, "read_only": {"const": true}}}
  }
}
