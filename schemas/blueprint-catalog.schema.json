{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/blueprint-catalog.schema.json",
  "title": "Spectra Blueprint Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "catalog_version", "blueprints"],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"const": "spectra"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "blueprints": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/blueprint"}}
  },
  "$defs": {
    "blueprint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "kind", "title", "purpose", "profiles", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^BPC-[A-Z0-9-]+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"enum": ["confluence-project", "jira-project", "blank-documents", "metadata"]},
        "title": {"type": "string", "minLength": 3},
        "purpose": {"type": "string", "minLength": 10},
        "profiles": {"type": "array", "minItems": 1, "items": {"enum": ["implementation", "support-only", "fit-gap-only", "migration"]}},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "title", "source_path", "target_path", "purpose", "leading_location", "required_fields", "optional_fields", "allowed_references", "content_boundary", "visibility", "blank"],
      "properties": {
        "template_id": {"type": "string", "pattern": "^TPL-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 2},
        "source_path": {"type": "string", "minLength": 3},
        "target_path": {"type": "string", "minLength": 3},
        "purpose": {"type": "string", "minLength": 10},
        "leading_location": {"type": "string", "minLength": 2},
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "optional_fields": {"type": "array", "items": {"type": "string"}},
        "allowed_references": {"type": "array", "items": {"type": "string"}},
        "content_boundary": {"type": "string", "minLength": 10},
        "visibility": {"enum": ["internal_restricted", "project_shared"]},
        "blank": {"const": true}
      }
    }
  }
}
