{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bcprojectos.invalid/schemas/adapter-provenance.schema.json",
  "title": "Spectra Adapter Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract_version","record_type","provenance_id","product_id","profile","classification","synthetic","source","mapping","projection","source_of_truth","write_protection"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "record_type": {"const": "adapter-provenance"},
    "provenance_id": {"type": "string", "pattern": "^PRV-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "product_id": {"const": "spectra"},
    "profile": {"enum": ["implementation","support-only"]},
    "classification": {"enum": ["synthetic-fixture","customer-workspace"]},
    "synthetic": {"type": "boolean"},
    "source": {"$ref": "#/$defs/source"},
    "mapping": {"$ref": "#/$defs/mapping"},
    "projection": {"$ref": "#/$defs/projection"},
    "source_of_truth": {"$ref": "#/$defs/source_of_truth"},
    "write_protection": {"$ref": "#/$defs/write_protection"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blob_path","source_hash","source_hash_after","media_type"],
      "properties": {
        "blob_path": {"type": "string", "minLength": 1},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_hash_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id","mapping_version","deterministic"],
      "properties": {
        "mapping_id": {"type": "string", "pattern": "^MAP-[A-Z0-9][A-Z0-9-]{2,63}$"},
        "mapping_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "deterministic": {"type": "boolean"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_path","digest_algorithm","projection_digest"],
      "properties": {
        "projection_path": {"type": "string", "minLength": 1},
        "digest_algorithm": {"const": "SHA-256"},
        "projection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner","unchanged"],
      "properties": {
        "owner": {"enum": ["synthetic-fixture","customer-workspace"]},
        "unchanged": {"type": "boolean"}
      }
    },
    "write_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mode","writes_performed","projection_only","overwrite_allowed"],
      "properties": {
        "source_mode": {"const": "read-only"},
        "writes_performed": {"type": "boolean"},
        "projection_only": {"type": "boolean"},
        "overwrite_allowed": {"type": "boolean"}
      }
    }
  }
}
