{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectra Project Story",
  "type": "object",
  "required": ["offer", "pages", "tickets", "timeline", "hypercare", "evidence", "graph"],
  "additionalProperties": false,
  "properties": {
    "offer": {"$ref":"#/$defs/offer"}, "pages":{"type":"array","items":{"$ref":"#/$defs/page"}},
    "tickets":{"type":"array","items":{"$ref":"#/$defs/ticket"}}, "timeline":{"type":"array","items":{"$ref":"#/$defs/timeline"}},
    "hypercare":{"type":"array","items":{"$ref":"#/$defs/hypercare"}}, "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "graph":{"type":"array","items":{"$ref":"#/$defs/edge"}}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._-]{2,63}$"},
    "time": {"type":"string","format":"date-time"},
    "offer": {"type":"object","additionalProperties":false,"required":["id","version","scope","assumptions","deliverables","planned_hours","planned_cost","actual_hours","actual_cost","gates"],"properties":{"id":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1},"scope":{"type":"string","minLength":1},"assumptions":{"type":"array","items":{"type":"string"}},"deliverables":{"type":"array","items":{"type":"string"}},"planned_hours":{"type":"number","minimum":0},"planned_cost":{"type":"number","minimum":0},"actual_hours":{"type":"number","minimum":0},"actual_cost":{"type":"number","minimum":0},"gates":{"type":"array","items":{"type":"string"}}}},
    "page": {"type":"object","additionalProperties":false,"required":["id","sourcePath","parent","version","status","author_role","time","title","references"],"properties":{"id":{"$ref":"#/$defs/id"},"sourcePath":{"type":"string","pattern":"^[^\\s]+$"},"parent":{"type":["string","null"]},"version":{"type":"integer","minimum":1},"status":{"type":"string","enum":["draft","published","archived"]},"author_role":{"type":"string","minLength":1},"time":{"$ref":"#/$defs/time"},"title":{"type":"string","minLength":1},"references":{"type":"array","items":{"$ref":"#/$defs/id"}}}},
    "status": {"type":"object","additionalProperties":false,"required":["status","time"],"properties":{"status":{"type":"string","enum":["open","in_progress","tested","done","closed","cancelled"]},"time":{"$ref":"#/$defs/time"}}},
    "acceptance": {"type":"string","minLength":1},
    "comment": {"type":"object","additionalProperties":false,"required":["id","time","author_role","type","text","evidence"],"properties":{"id":{"$ref":"#/$defs/id"},"time":{"$ref":"#/$defs/time"},"author_role":{"type":"string","minLength":1},"type":{"type":"string","enum":["working","handoff","closing"]},"text":{"type":"string","minLength":1},"evidence":{"type":"array","items":{"$ref":"#/$defs/id"}}}},
    "worklog": {"type":"object","additionalProperties":false,"required":["id","date","role","hours","activity","phase","cost"],"properties":{"id":{"$ref":"#/$defs/id"},"date":{"type":"string","format":"date"},"role":{"type":"string","minLength":1},"hours":{"type":"number","exclusiveMinimum":0},"activity":{"type":"string","minLength":1},"phase":{"type":"string","minLength":1},"cost":{"type":"number","minimum":0}}},
    "ticket": {"type":"object","additionalProperties":false,"required":["id","type","summary","description","reporter","assignee","priority","parent","dependencies","labels","components","created","status","acceptance","evidence","status_history","worklogs","comments"],"properties":{"id":{"$ref":"#/$defs/id"},"type":{"type":"string","enum":["epic","story","task","subtask","bug","change","support"]},"summary":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"reporter":{"type":"string","minLength":1},"assignee":{"type":"string","minLength":1},"priority":{"type":"string","enum":["P1","P2","P3","P4"]},"parent":{"type":["string","null"]},"dependencies":{"type":"array","items":{"$ref":"#/$defs/id"}},"labels":{"type":"array","items":{"type":"string"}},"components":{"type":"array","items":{"type":"string"}},"created":{"$ref":"#/$defs/time"},"status":{"type":"string","enum":["open","in_progress","tested","done","closed","cancelled"]},"acceptance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/acceptance"}},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}},"status_history":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/status"}},"worklogs":{"type":"array","items":{"$ref":"#/$defs/worklog"}},"comments":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/comment"}}}},
    "timeline": {"type":"object","additionalProperties":false,"required":["id","time","phase","role","references","state","action","result","decision","nextStep","evidence"],"properties":{"id":{"$ref":"#/$defs/id"},"time":{"$ref":"#/$defs/time"},"phase":{"type":"string","minLength":1},"role":{"type":"string","minLength":1},"references":{"type":"array","items":{"$ref":"#/$defs/id"}},"state":{"type":"string","minLength":1},"action":{"type":"string","minLength":1},"result":{"type":"string","minLength":1},"decision":{"type":"string","minLength":1},"nextStep":{"type":"string","minLength":1},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}}},
    "hypercare": {"type":"object","additionalProperties":false,"required":["day","daily_page","tickets","priority","diagnosis","fix","retest","trend","nextDay","go_no_go","status"],"properties":{"day":{"type":"integer","minimum":1},"daily_page":{"$ref":"#/$defs/id"},"tickets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}},"priority":{"type":"string","enum":["P1","P2","P3","P4"]},"diagnosis":{"type":"string","minLength":1},"fix":{"type":"string","minLength":1},"retest":{"type":"string","minLength":1},"trend":{"type":"string","minLength":1},"nextDay":{"type":"string","minLength":1},"go_no_go":{"type":"string","enum":["GO","NO-GO"]},"status":{"type":"string","enum":["open","closed"]}}},
    "evidence": {"type":"object","additionalProperties":false,"required":["id","hash","type"],"properties":{"id":{"$ref":"#/$defs/id"},"hash":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},"type":{"type":"string","minLength":1}}},
    "edge": {"type":"object","additionalProperties":false,"required":["from","to","type"],"properties":{"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"},"type":{"type":"string","enum":["offer-page","page-offer","page-ticket","ticket-page","ticket-evidence","evidence-ticket","ticket-story","story-ticket"]}}}
  }
}
