{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/document-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "classification", "customer_id", "snapshot", "documentation", "jira"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "product_id": {"type": "string", "const": "spectra"},
    "classification": {"type": "string", "const": "synthetic-template"},
    "customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]+$"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "documentation": {"$ref": "#/$defs/documentation"},
    "jira": {"$ref": "#/$defs/jira"}
  },
  "$defs": {
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_revision", "source_digest", "generated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^SNP-[A-Z0-9-]+$"},
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "documentation": {
      "type": "object", "additionalProperties": false,
      "required": ["spaces", "nodes", "documents", "references", "provenance"],
      "properties": {
        "spaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/space"}},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "space": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "customer_id", "name", "order", "home_node_id", "home_document_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^SPC-[A-Z0-9-]+$"},
        "customer_id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "home_node_id": {"type": "string"},
        "home_document_id": {"type": "string"},
        "external": {"$ref": "#/$defs/external"}
      }
    },
    "external": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["provider", "origin", "external_id"],
      "properties": {
        "provider": {"type": "string", "const": "atlassian"},
        "origin": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+$"},
        "external_id": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "customer_id", "space_id", "parent_id", "document_id", "order", "initially_expanded"],
      "properties": {
        "id": {"type": "string", "pattern": "^NOD-[A-Z0-9-]+$"},
        "customer_id": {"type": "string"},
        "space_id": {"type": "string"},
        "parent_id": {"type": ["string", "null"]},
        "document_id": {"type": "string"},
        "order": {"type": "integer", "minimum": 0},
        "initially_expanded": {"type": "boolean"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "customer_id", "title", "content_mode", "source_path", "blueprint_id", "provenance_ids", "authored_sections"],
      "properties": {
        "id": {"type": "string", "pattern": "^DOC-[A-Z0-9-]+$"},
        "customer_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "content_mode": {"type": "string", "enum": ["generated", "authored"]},
        "source_path": {"type": "string", "minLength": 1},
        "blueprint_id": {"type": ["string", "null"], "pattern": "^BPC-[A-Z0-9-]+$"},
        "provenance_ids": {"type": "array", "items": {"type": "string"}},
        "authored_sections": {"type": "array", "items": {"type": "string"}}
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "id"],
      "properties": {
        "domain": {"type": "string", "enum": ["space", "node", "document", "ticket", "view", "provenance"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "customer_id", "from", "to", "relation_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"},
        "customer_id": {"type": "string"},
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"},
        "relation_type": {"type": "string", "enum": ["contains", "documents", "supports", "derived-from", "visualizes"]}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "customer_id", "source_system", "source_object_id", "source_revision", "source_digest", "validation_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^PRV-[A-Z0-9-]+$"},
        "customer_id": {"type": "string"},
        "source_system": {"type": "string", "enum": ["spectra-workspace", "repository", "atlassian-snapshot"]},
        "source_object_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "validation_status": {"type": "string", "const": "validated"}
      }
    },
    "jira": {
      "type": "object", "additionalProperties": false,
      "required": ["tickets", "views"],
      "properties": {
        "tickets": {"type": "array", "items": {"$ref": "#/$defs/ticket"}},
        "views": {"type": "array", "items": {"$ref": "#/$defs/view"}}
      }
    },
    "ticket": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "customer_id", "type", "status", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^TKT-[A-Z0-9-]+$"},
        "customer_id": {"type": "string"},
        "type": {"type": "string", "enum": ["epic", "story", "task", "bug", "support"]},
        "status": {"type": "string", "enum": ["open", "in-progress", "done", "closed"]},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "customer_id", "name", "ticket_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^VIW-[A-Z0-9-]+$"},
        "customer_id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "ticket_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
