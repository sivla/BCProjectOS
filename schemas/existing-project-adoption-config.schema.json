{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/existing-project-adoption-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "config_id", "workspace", "product_binding", "discovery_binding", "jira_binding", "confluence_bindings", "mapping", "runtime_secret_keys"],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"const": "spectra"},
    "config_id": {"type": "string", "pattern": "^ADC-[A-Z0-9-]{3,60}$"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "product_binding": {"$ref": "#/$defs/productBinding"},
    "discovery_binding": {"$ref": "#/$defs/discoveryBinding"},
    "jira_binding": {"$ref": "#/$defs/jiraBinding"},
    "confluence_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/confluenceBinding"}},
    "mapping": {"$ref": "#/$defs/mapping"},
    "runtime_secret_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SPECTRA_[A-Z0-9_]{4,80}$"}}
  },
  "$defs": {
    "workspace": {"type": "object", "additionalProperties": false, "required": ["customer_id", "customer_name", "workspace_id", "profile", "project_id", "project_name"], "properties": {"customer_id": {"type": "string", "pattern": "^CUS-[A-Z0-9-]+$"}, "customer_name": {"type": "string", "minLength": 2}, "workspace_id": {"type": "string", "pattern": "^WS-[A-Z0-9-]+$"}, "profile": {"enum": ["implementation", "support-only"]}, "project_id": {"type": ["string", "null"]}, "project_name": {"type": ["string", "null"]}}},
    "productBinding": {"type": "object", "additionalProperties": false, "required": ["release_status", "installable_blueprint", "version", "commit", "tree", "digest", "manifest_path"], "properties": {"release_status": {"enum": ["BOUND", "PENDING_BCPROJECTOS_RELEASE"]}, "installable_blueprint": {"type": "boolean"}, "version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:alpha|beta)\\.[1-9][0-9]*|-rc\\.[1-9][0-9]*)?$"}, "commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"}, "tree": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"}, "digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "manifest_path": {"type": ["string", "null"], "pattern": "^release/versions/[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:alpha|beta)\\.[1-9][0-9]*|-rc\\.[1-9][0-9]*)?/release-manifest\\.json$"}}},
    "discoveryBinding": {"type": "object", "additionalProperties": false, "required": ["discovery_id", "source_revision", "sha256", "relative_path"], "properties": {"discovery_id": {"type": "string", "minLength": 3}, "source_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "relative_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"}}},
    "jiraBinding": {"type": "object", "additionalProperties": false, "required": ["base_url", "site_id", "project_id", "project_key", "board_id", "board_name", "filter_id"], "properties": {"base_url": {"type": "string", "pattern": "^https://[^/?#]+$"}, "site_id": {"type": "string", "minLength": 2}, "project_id": {"type": ["string", "null"]}, "project_key": {"type": ["string", "null"]}, "board_id": {"type": "string", "minLength": 1}, "board_name": {"type": "string", "minLength": 2}, "filter_id": {"type": ["string", "null"]}}},
    "confluenceBinding": {"type": "object", "additionalProperties": false, "required": ["base_url", "site_id", "space_id", "space_key", "role", "root_page_id"], "properties": {"base_url": {"type": "string", "pattern": "^https://[^/?#]+$"}, "site_id": {"type": "string", "minLength": 2}, "space_id": {"type": "string", "minLength": 1}, "space_key": {"type": "string", "minLength": 2}, "role": {"enum": ["project", "support", "knowledge", "company", "product", "consulting", "archive"]}, "root_page_id": {"type": ["string", "null"]}}},
    "mappingEntry": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_name", "target"], "properties": {"source_id": {"type": "string", "minLength": 1}, "source_name": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["version", "issue_types", "statuses", "fields", "space_roles"], "properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "issue_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mappingEntry"}}, "statuses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mappingEntry"}}, "fields": {"type": "array", "items": {"$ref": "#/$defs/mappingEntry"}}, "space_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mappingEntry"}}}}
  }
}
