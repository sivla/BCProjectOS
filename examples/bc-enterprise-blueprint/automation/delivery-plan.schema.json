{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BC Delivery Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "changeId",
    "projectId",
    "businessDomain",
    "externalPublishingEnabled",
    "ticketing",
    "uat",
    "documentation",
    "training",
    "release"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "changeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "projectId": { "type": "string", "pattern": "^PRJ-[A-Z0-9-]+$" },
    "businessDomain": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
    "externalPublishingEnabled": { "const": false },
    "ticketing": {
      "type": "object",
      "required": ["required", "epic", "storiesFrom", "tasksFrom"],
      "properties": {
        "required": { "type": "boolean" },
        "epic": {
          "type": "object",
          "required": ["mode", "sourceId", "title"],
          "properties": {
            "mode": { "enum": ["existing", "create"] },
            "sourceId": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
            "title": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "storiesFrom": { "const": "requirements" },
        "tasksFrom": { "const": "tasks" }
      },
      "additionalProperties": false
    },
    "uat": { "$ref": "#/$defs/requiredFlag" },
    "documentation": {
      "type": "object",
      "required": ["required", "confluenceStylePages", "spaceAlias"],
      "properties": {
        "required": { "type": "boolean" },
        "confluenceStylePages": { "type": "boolean" },
        "spaceAlias": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "training": {
      "type": "object",
      "required": ["required", "purpose", "audiences"],
      "properties": {
        "required": { "type": "boolean" },
        "purpose": { "type": "string" },
        "audiences": { "type": "array" }
      },
      "additionalProperties": false
    },
    "release": { "$ref": "#/$defs/requiredFlag" }
  },
  "$defs": {
    "requiredFlag": {
      "type": "object",
      "required": ["required"],
      "properties": { "required": { "type": "boolean" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
